# =============================================================================
# DEVFORGE AI - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash AI generation,
# planning, code actions, and automated diagnostics.
# Never expose this key to client-side code or commit real values to git.
GEMINI_API_KEY=""

# PORT: The port the HTTP server binds to (default: 3000).
# Production PaaS providers (e.g., Render, Heroku, Cloud Run, Railway)
# set this environment variable automatically.
PORT=3000

# NODE_ENV: Set to 'production' for public hosted deployments.
NODE_ENV=production

# DEVFORGE_DATA_DIR: Path to local directory where durable data (users, sessions,
# transactions, and forged projects) is stored on disk (default: ./data).
# For production hosting, point this to an attached persistent volume or mount path.
DEVFORGE_DATA_DIR=./data

# APP_URL: The public base URL where this applet is hosted.
# Used for absolute URL generation, OAuth callbacks, and API documentation.
APP_URL=""

